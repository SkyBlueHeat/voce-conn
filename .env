# Voice Assistant Configuration

# Debug mode (true/false) - Hata ayiklama modunu aktif/pasif yapar
DEBUG_MODE='true'

# Wake word to activate assistant - Asistani aktifleştiren uyandirma kelimesi
WAKE_WORD='jarvis'

# Conversation timeout in seconds - Konuşma zaman aşimi (saniye)
CONVERSATION_TIMEOUT=60

# Voice feedback (true/false) - Sesli geri bildirim açik/kapali
VOICE_FEEDBACK='true'

# Text-to-Speech Engine Configuration (TTS)
# ----------------------------------------
# TTS_ENGINE: Kullanilacak TTS motoru - 'edge-tts' veya 'pyttsx3'
# edge-tts: Microsoft'un yuksek kaliteli, doğal insan sesi
# pyttsx3: Yerel, internet gerektirmeyen TTS motoru
TTS_ENGINE='edge-tts'

# Edge TTS ayarlari (TTS_ENGINE=edge-tts ise kullanilir)
# -----------------------------------------------------
# EDGE_TTS_VOICE: Kullanilacak ses - Mevcut Turkçe sesler:
#  - tr-TR-EmelNeural: Kadin sesi (onerilen)
#  - tr-TR-AhmetNeural: Erkek sesi
EDGE_TTS_VOICE=tr-TR-EmelNeural

# Konuşma hizi: -50% (çok yavaş) ile +100% (çok hizli) arasi
EDGE_TTS_RATE=+0%

# Ses seviyesi: -50% (çok kisik) ile +50% (çok yuksek) arasi
EDGE_TTS_VOLUME=+0%

# Pyttsx3 ayarlari (TTS_ENGINE=pyttsx3 ise kullanilir)
# ---------------------------------------------------
# Konuşma hizi: Duşuk sayi = daha yavaş konuşma (75-200 arasi)
TTS_RATE='+175%'
# Ses seviyesi (0.0 - 1.0)
TTS_VOLUME='+1%'

# Wake word detector settings (Porcupine)
SENSITIVITY=0.7
# NOT: Bu satırı kendi Picovoice/Porcupine API anahtarınızla değiştirmelisiniz
# https://console.picovoice.ai/ adresinden ücretsiz bir anahtar alabilirsiniz
PORCUPINE_ACCESS_KEY=YOUR_PORCUPINE_ACCESS_KEY

# Speech recognition settings
ENERGY_THRESHOLD=300    

# Vosk model settings
VOSK_MODEL_PATH=vosk-model-tr

# Application settings
LANGUAGE=tr 
TTS_VOICE='tr-TR-EmelNeural'
