# Voice Assistant Configuration

# Debug mode (true/false) - Hata ayıklama modunu aktif/pasif yapar
DEBUG_MODE='true'

# Wake word to activate assistant - Asistanı aktifleştiren uyandırma kelimesi
WAKE_WORD='jarvis'

# Conversation timeout in seconds - Konuşma zaman aşımı (saniye)
CONVERSATION_TIMEOUT=60

# Voice feedback (true/false) - Sesli geri bildirim açık/kapalı
VOICE_FEEDBACK='true'

# Text-to-Speech Engine Configuration (TTS)
# ----------------------------------------
# TTS_ENGINE: Kullanılacak TTS motoru - 'edge-tts' veya 'pyttsx3'
# edge-tts: Microsoft'un yüksek kaliteli, doğal insan sesi
# pyttsx3: Yerel, internet gerektirmeyen TTS motoru
TTS_ENGINE='edge-tts'

# Edge TTS ayarları (TTS_ENGINE=edge-tts ise kullanılır)
# -----------------------------------------------------
# EDGE_TTS_VOICE: Kullanılacak ses - Mevcut Türkçe sesler:
#  - tr-TR-EmelNeural: Kadın sesi (önerilen)
#  - tr-TR-AhmetNeural: Erkek sesi
EDGE_TTS_VOICE=tr-TR-EmelNeural

# Konuşma hızı: -50% (çok yavaş) ile +100% (çok hızlı) arası
EDGE_TTS_RATE=+0%

# Ses seviyesi: -50% (çok kısık) ile +50% (çok yüksek) arası
EDGE_TTS_VOLUME=+0%

# Pyttsx3 ayarları (TTS_ENGINE=pyttsx3 ise kullanılır)
# ---------------------------------------------------
# Konuşma hızı: Düşük sayı = daha yavaş konuşma (75-200 arası)
TTS_RATE='+175%'
# Ses seviyesi (0.0 - 1.0)
TTS_VOLUME='+1%'

# Wake word detector settings (Porcupine)
SENSITIVITY=0.7
PORCUPINE_ACCESS_KEY=Tawvv+6qt9lBeAKKK4TM2wMqzw2oirKK+0rX5J4e7ykyZJ54FoAk4Q==

# Speech recognition settings
ENERGY_THRESHOLD=300

# Vosk model settings
VOSK_MODEL_PATH=vosk-model-tr

# Application settings
LANGUAGE=tr 
TTS_VOICE='tr-TR-EmelNeural'
